---
import type { ToolSlug } from "#lib/tools"

import Text from "#components/atoms/Text.astro"

interface Props {
	slug: ToolSlug
	icon: string
}

const { slug, icon } = Astro.props
---

<a class="tool-card" href={`/${slug}/`}>
	<span class="icon" aria-hidden="true">{icon}</span>
	<span class="name"><Text pick={(m) => m.tools[slug].name} /></span>
	<span class="tagline"><Text pick={(m) => m.tools[slug].tagline} /></span>
</a>

<style>
.tool-card {
	display: grid;
	grid-template-columns: auto 1fr;
	column-gap: var(--pad);
	row-gap: 4px;
	align-items: center;
	padding: var(--pad) calc(var(--pad) + 4px);
	color: var(--text);
	text-decoration: none;
	/* A Surface card's look: a link card in an .astro file cannot be the Svelte Surface. */
	background: var(--surface);
	border: var(--border) solid var(--ink);
	border-radius: var(--radius);
	box-shadow: var(--shadow);
	transition:
		box-shadow 0.15s,
		transform 0.15s;
}

/* Lifts like a sticker peeled up. */
.tool-card:hover {
	box-shadow: var(--shadow-pop);
	transform: translate(-1px, -1px);
}

.tool-card:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: 2px;
}

.icon {
	grid-row: span 2;
	font-size: 1.75rem;
}

.name {
	font-family: var(--font-head);
	font-weight: 500;
}

.tagline {
	grid-column: 2;
	font-size: 0.875rem;
	color: var(--muted);
}

@media (prefers-reduced-motion: reduce) {
	.tool-card {
		transition: none;
	}
}
</style>
