---
import type { ToolSlug } from "#lib/tools"

import Text from "#components/atoms/Text.astro"

interface Props {
	slug: ToolSlug
	icon: string
}

const { slug, icon } = Astro.props
---

<a class="tool-card" href={`/${slug}/`}>
	<span class="icon" aria-hidden="true">{icon}</span>
	<span class="name"><Text pick={(m) => m.tools[slug].name} /></span>
	<span class="tagline"><Text pick={(m) => m.tools[slug].tagline} /></span>
</a>

<style>
.tool-card {
	display: grid;
	grid-template-columns: auto 1fr;
	column-gap: 12px;
	row-gap: 4px;
	align-items: center;
	padding: 16px;
	color: var(--text);
	text-decoration: none;
	background: var(--surface);
	border: 1px solid var(--line);
	border-radius: var(--radius-lg);
	transition: border-color 0.15s;
}

.tool-card:hover {
	background: var(--hover);
	border-color: var(--accent);
}

.tool-card:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: 2px;
}

.icon {
	grid-row: span 2;
	font-size: 1.75rem;
}

.name {
	font-weight: 600;
}

.tagline {
	grid-column: 2;
	font-size: 0.875rem;
	color: var(--muted);
}

@media (prefers-reduced-motion: reduce) {
	.tool-card {
		transition: none;
	}
}
</style>
