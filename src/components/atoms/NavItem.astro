---
import type { Lang } from "#lib/lang"

interface Props {
	href: string
	icon: string
	/** Both languages: an atom imports no component, so it renders the spans `Text` would. */
	label: Record<Lang, string>
	current?: boolean
}

const { href, icon, label, current = false } = Astro.props
// The shape l10nAttr("title", …) makes: Thai as the value, both as data, swapped by localizeAttrs.
const title = { title: label.th, "data-title-th": label.th, "data-title-en": label.en, "data-l10n": "" }
---

<a class="nav-item" href={href} {...title} aria-current={current ? "page" : undefined}>
	<span class="icon" aria-hidden="true">{icon}</span>
	<span class="label"><span data-lang="th">{label.th}</span><span data-lang="en">{label.en}</span></span>
</a>

<style>
.nav-item {
	display: flex;
	align-items: center;
	gap: 12px;
	min-height: var(--tap);
	padding: 9px 10px;
	border-radius: var(--radius);
	color: var(--muted);
	text-decoration: none;
	white-space: nowrap;
}

.nav-item:hover {
	background: var(--hover);
	color: var(--text);
}

.nav-item:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -2px;
}

.nav-item[aria-current="page"] {
	background: var(--hover);
	color: var(--text);
	font-weight: 600;
}

.icon {
	flex: none;
	width: 22px;
	font-size: 17px;
	text-align: center;
}

.nav-item[aria-current="page"] .icon {
	color: var(--accent);
}

.label {
	transition: opacity 0.2s;
}
</style>
