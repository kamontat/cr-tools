---
interface Props {
	href: string
	icon: string
	label: string
	current?: boolean
}

const { href, icon, label, current = false } = Astro.props
---

<a class="nav-item" href={href} title={label} aria-current={current ? "page" : undefined}>
	<span class="icon" aria-hidden="true">{icon}</span>
	<span class="label">{label}</span>
</a>

<style>
.nav-item {
	display: flex;
	align-items: center;
	gap: 12px;
	min-height: var(--tap);
	padding: 9px 10px;
	border-radius: var(--radius);
	color: var(--muted);
	text-decoration: none;
	white-space: nowrap;
}

.nav-item:hover {
	background: var(--hover);
	color: var(--text);
}

.nav-item:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -2px;
}

.nav-item[aria-current="page"] {
	background: var(--hover);
	color: var(--text);
	font-weight: 600;
}

.icon {
	flex: none;
	width: 22px;
	font-size: 17px;
	text-align: center;
}

.nav-item[aria-current="page"] .icon {
	color: var(--accent);
}

.label {
	transition: opacity 0.2s;
}
</style>
