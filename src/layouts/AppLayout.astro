---
import type { FramePage } from "#lib/frame"

import Sidebar from "#components/organisms/Sidebar.astro"
import TopBar from "#components/organisms/TopBar.astro"
import BaseLayout from "#layouts/BaseLayout.astro"
import { FULL_MIN_WIDTH, SIDEBAR_KEY } from "#lib/frame"

interface Props {
	title: string
	current: FramePage
}

const { title, current } = Astro.props
---

<BaseLayout title={title}>
	<script define:vars={{ SIDEBAR_KEY, FULL_MIN_WIDTH }}>
	// Before first paint, so a sidebar closed on a wide screen does not flash open.
	// define:vars ships it inline; initFrame takes over after.
	try {
		if (window.innerWidth >= FULL_MIN_WIDTH && localStorage.getItem(SIDEBAR_KEY) === "closed")
			document.body.dataset.sidebar = "closed"
	} catch {}
	</script>
	<TopBar title={title} />
	<div class="frame">
		<Sidebar current={current} />
		<div id="sidebar-scrim" class="scrim" aria-hidden="true"></div>
		<main id="content">
			<slot />
		</main>
	</div>
	<script>
	import { initFrame } from "#lib/frame"
	import { localStore } from "#lib/storage"

	initFrame(document, localStore())
	</script>
</BaseLayout>

<style>
/*
 * Breakpoints follow sidebarMode in #lib/frame. The sidebar takes the first
 * column while it is in the page's flow; over the page it is fixed, so main
 * names its column rather than flowing into the sidebar's.
 */
.frame {
	display: grid;
	grid-template-columns: auto minmax(0, 1fr);
	min-height: calc(100dvh - 52px);
}

main {
	grid-column: 2;
	min-width: 0;
}

.scrim {
	display: none;
}

@media (width < 1100px) {
	.frame {
		grid-template-columns: 60px minmax(0, 1fr);
	}

	:global(body[data-sidebar="open"]) .scrim {
		display: block;
		position: fixed;
		inset: 52px 0 0;
		z-index: 15;
		background: rgb(0 0 0 / 50%);
	}
}

@media (width < 700px) {
	.frame {
		grid-template-columns: minmax(0, 1fr);
	}

	main {
		grid-column: 1;
	}
}
</style>
