---
import "../styles/global.css"
import { readBuildInfo } from "#lib/build-info"

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en" data-env={readBuildInfo().environment}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="icon" href="/assets/cookies/fairy_cookie.png">
		<meta name="generator" content={Astro.generator}>
		<title>{title}</title>
		<script is:inline>
		try {
			const theme = localStorage.getItem("theme")
			if (theme === "dark" || theme === "light") document.documentElement.setAttribute("data-theme", theme)
		} catch {}
		</script>
		<script>
		import { loadGtm } from "#lib/gtm"

		// Inlined at build time; unset (dev, previews, local builds) leaves GTM off.
		loadGtm(import.meta.env.PUBLIC_GTM_ID, document)
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
